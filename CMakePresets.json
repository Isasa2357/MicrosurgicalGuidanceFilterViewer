{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 (x64)",
      "description": "Fetch and build OpenCV without vcpkg using Visual Studio 2026",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs2026"
    }
  ],
  "buildPresets": [
    {
      "name": "vs2026-release",
      "displayName": "Visual Studio 2026 Release",
      "configurePreset": "vs2026",
      "configuration": "Release",
      "jobs": 4
    }
  ]
}
